[Unit]
Description=Refresh local Turbid Vision Probe network discovery
After=network-online.target

[Service]
Type=oneshot
User=pioreactor
EnvironmentFile=/etc/pioreactor.env
Environment=DOT_PIOREACTOR=/home/pioreactor/.pioreactor
ExecStart=/opt/pioreactor/venv/bin/python -c "from turbidvision_pioreactor.dashboard_discovery import main; main()"
